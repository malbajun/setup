+               $stdout = $stderr
+
+               require 'rake'
+#               require 'pry';binding.pry
+
+
+               module_name = "M" + Random.srand.to_s
+               mod_code = <<-END
+                  module #{module_name}
+                     extend(Rake::DSL)
+
+                     # in some cases __dir__ is nil inside the Rakefile, but should not
+                     __dir__ ||= '.'
+
+                     eval(IO.read('#{rakefile}'))
