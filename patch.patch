+class Array
+   # actjoin(array) => [<pre_match1>, <pre_match2>, <pre_match3>, <post_match>]; array = [match1, match2, match3]
+   #
+   def actjoin array
+      self.map.with_index { |x, i| [ x, array[i] ].compact }.flatten.join
+   end
