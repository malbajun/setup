diff --git a/lib/setup/core_ext.rb b/lib/setup/core_ext.rb
index e66f938..13472b9 100644
--- a/lib/setup/core_ext.rb
+++ b/lib/setup/core_ext.rb
@@ -30,3 +30,25 @@ unless Errno.const_defined?(:ENOTEMPTY)   # Windows?
 
 end
 
+module Kernel
+  alias :__old_system_call :`
+
+  def ` cmd
+    tokens = cmd.split(/\s+/)
+
+    $stderr.puts '----'
+    $stderr.puts tokens
+    $stderr.puts '===='
+
+    res = __old_system_call(cmd)
+
+    if tokens.first == 'git' && tokens[1] == 'ls-files' && res.empty?
+      mask = tokens[2..-1].select { |t| t !~ /^-/ }.first&.sub('*', '**/*') || '**/*'
+      list = Dir.glob(mask, File::FNM_DOTMATCH).select { |x| File.file?(x) }
+      char = tokens.include?('-z') && "\0" || "\n"
+      list.join(char)
+    else
+      res
+    end
+  end
+end
